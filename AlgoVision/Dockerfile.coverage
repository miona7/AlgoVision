FROM ubuntu:22.04

RUN apt-get update && \
    apt-get install -y \
        build-essential \
        cmake \
        git \
        lcov \
        python3 \
        qtbase5-dev \
        qt5-qmake \
        bash && \
    apt-get clean

WORKDIR /app

COPY coverage.sh /app/coverage.sh
RUN chmod +x coverage.sh

CMD ["bash"]
